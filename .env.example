# Benachrichtigungen — mindestens E-Mail ODER Telegram konfigurieren

# Option A: E-Mail via Resend (https://resend.com — gratis bis 100/Tag)
RESEND_API_KEY=
NOTIFY_EMAIL=deine@email.de
# RESEND_FROM=Vonni <notify@deine-domain.de>

# Option B: Telegram (Bot an @BotFather, Chat-ID via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Schutz vor Spam auf der öffentlichen URL
NOTIFY_SECRET=
VITE_NOTIFY_SECRET=
